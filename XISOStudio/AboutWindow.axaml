<Window x:Class="XISOStudio.AboutWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About XISO Studio"
        Icon="avares://XISOStudio/icon/icon.png"
        Width="800"
        Height="700"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <!-- Logo Section -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,15"
                    Padding="15">
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="120"
                           Height="120"
                           Source="avares://XISOStudio/images/logo.png"
                           ToolTip.Tip="XISO Studio application logo" />
                </StackPanel>
            </Border>

            <!-- Title & Version Section -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,15"
                    Padding="20">
                <StackPanel>
                    <TextBlock FontWeight="Bold"
                               FontSize="22"
                               Foreground="{StaticResource HeaderTextBrush}"
                               Text="XISO Studio"
                               HorizontalAlignment="Center"
                               ToolTip.Tip="A high-performance utility for Xbox preservation and emulation" />
                    <TextBlock Name="AppVersionTextBlock"
                               Margin="0,8,0,0"
                               Text=""
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               ToolTip.Tip="Current application version" />
                </StackPanel>
            </Border>

            <!-- Description Section -->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,15"
                    Padding="20">
                <StackPanel>
                    <TextBlock FontWeight="Bold"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Description"
                               Margin="0,0,0,10"
                               ToolTip.Tip="About XISO Studio" />
                    <TextBlock Text="A high-performance utility for the Xbox preservation and emulation community, running on Windows, Linux, and macOS. This application streamlines the process of converting standard Xbox and Xbox 360 ISOs into the optimized, trimmed XISO format."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Margin="0,0,0,12"
                               ToolTip.Tip="XISO Studio converts Xbox/Xbox 360 ISOs into trimmed XISO format, saving space while preserving content" />
                    <TextBlock
                        Text="Features include batch conversion powered by the XISOSharp library, integrity testing with deep scanning for ISO, CSO, CCI, ZAR, CHD and STFS/XBLA images, a decompression view, and an image explorer with GOD/SVOD support, title metadata, checksums, XBE image previews, and drag-and-drop extraction."
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="Wrap"
                        LineHeight="20"
                        ToolTip.Tip="Key features: batch conversion to XISO/ZAR/CSO/CHD, ISO/CSO/ZAR/CHD integrity testing with deep scan, and an image explorer with drag-and-drop extraction" />
                </StackPanel>
            </Border>

            <!-- Acknowledgements Section -->
            <Border Grid.Row="3"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,15"
                    Padding="20">
                <StackPanel>
                    <TextBlock FontWeight="Bold"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Acknowledgements"
                               Margin="0,0,0,10"
                               ToolTip.Tip="Open-source projects and tools used by this application" />
                    <TextBlock Text="This application uses the following open-source projects and tools:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               ToolTip.Tip="Click any link to visit the project's GitHub repository" />

                    <StackPanel Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" ToolTip.Tip="Visit XISOSharp on GitHub — the library that powers all XISO reading, writing, and conversion">
                            <Button Content="XISOSharp" Theme="{StaticResource LinkButtonStyle}" Tag="https://github.com/purelogiccode/XISOSharp" Click="Hyperlink_Click" ToolTip.Tip="Open the XISOSharp GitHub repository" />
                            <TextBlock Text=" - XISO/XDVDFS reading, writing, and conversion library" Foreground="{StaticResource TextMutedBrush}" ToolTip.Tip="XISO/XDVDFS reading, writing, and conversion library used by XISO Studio" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" ToolTip.Tip="Visit ZArchiveSharp on GitHub — ZArchive/zstd compression library">
                            <Button Content="ZArchiveSharp" Theme="{StaticResource LinkButtonStyle}" Tag="https://github.com/purelogiccode/ZArchiveSharp" Click="Hyperlink_Click" ToolTip.Tip="Open the ZArchiveSharp GitHub repository" />
                            <TextBlock Text=" - ZArchive/zstd compression library" Foreground="{StaticResource TextMutedBrush}" ToolTip.Tip="ZArchive/zstd compression library used by XISO Studio" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" ToolTip.Tip="Visit StfsSharp on GitHub — Xbox 360 STFS/GOD reader">
                            <Button Content="StfsSharp" Theme="{StaticResource LinkButtonStyle}" Tag="https://github.com/purelogiccode/STFSSharp" Click="Hyperlink_Click" ToolTip.Tip="Open the StfsSharp GitHub repository" />
                            <TextBlock Text=" - Xbox 360 STFS/GOD reading" Foreground="{StaticResource TextMutedBrush}" ToolTip.Tip="Xbox 360 STFS/GOD reader used by XISO Studio" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" ToolTip.Tip="Visit CHDSharp on GitHub — CHD (Compressed Hunks of Data) reading and writing library">
                            <Button Content="CHDSharp" Theme="{StaticResource LinkButtonStyle}" Tag="https://github.com/purelogiccode/CHDSharp" Click="Hyperlink_Click" ToolTip.Tip="Open the CHDSharp GitHub repository" />
                            <TextBlock Text=" - CHD reading, verification, and creation" Foreground="{StaticResource TextMutedBrush}" ToolTip.Tip="CHD reading, verification, and creation library used by XISO Studio" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" ToolTip.Tip="Visit SharpCompress on GitHub — high-performance archive extraction library">
                            <Button Content="SharpCompress" Theme="{StaticResource LinkButtonStyle}" Tag="https://github.com/adamhathcock/sharpcompress" Click="Hyperlink_Click" ToolTip.Tip="Open the SharpCompress GitHub repository" />
                            <TextBlock Text=" - High-performance archive extraction" Foreground="{StaticResource TextMutedBrush}" ToolTip.Tip="High-performance archive extraction library used by XISO Studio" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Links & Close Section -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">

                <!-- Links -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Content="www.purelogiccode.com" Theme="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Tag="https://www.purelogiccode.com" Click="Hyperlink_Click" ToolTip.Tip="Visit the official website: www.purelogiccode.com" />
                    <Button Content="GitHub Repository" Theme="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" Tag="https://github.com/purelogiccode/XISOStudio" Click="Hyperlink_Click" ToolTip.Tip="Visit the project's GitHub repository" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1"
                        Width="100"
                        Height="36"
                        Click="CloseButton_Click"
                        Content="Close"
                        Theme="{StaticResource ActionButtonStyle}"
                        ToolTip.Tip="Close the about window" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
