<Window x:Class="XISOStudio.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:XISOStudio.Models"
        Title="XISO Studio"
        Icon="avares://XISOStudio/icon/icon.png"
        Height="850" Width="1200" MinHeight="650" MinWidth="800"
        Closing="Window_Closing"
        Loaded="Window_LoadedAsync"
        KeyDown="Window_KeyDownAsync"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource WindowBackgroundBrush}" RowDefinitions="Auto,*,Auto">

        <!-- Header (RomValidator Style) -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" Padding="15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="XISO Studio" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HeaderTextBrush}" VerticalAlignment="Center" Margin="0,0,30,0" ToolTip.Tip="XISO Studio — Xbox preservation utility" />
                    <Button x:Name="BtnNavConvert" Content="Convert" Click="NavConvert_Click" Theme="{StaticResource MenuButtonStyle}" ToolTip.Tip="Switch to the ISO to XISO batch conversion view" />
                    <Button x:Name="BtnNavTest" Content="Test Integrity" Click="NavTest_Click" Theme="{StaticResource MenuButtonStyle}" ToolTip.Tip="Switch to the image integrity testing view (ISO, CSO, ZAR)" />
                    <Button x:Name="BtnNavExplorer" Content="Explorer" Click="NavExplorer_Click" Theme="{StaticResource MenuButtonStyle}" ToolTip.Tip="Switch to the image file system explorer view (ISO, CSO, ZAR)" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Donate" Click="DonateButton_Click" Theme="{StaticResource DonateMenuButtonStyle}" ToolTip.Tip="Support the development of this application — opens the PureLogicCode donation page" />
                    <Button Content="About" Click="AboutMenuItem_ClickAsync" Theme="{StaticResource AboutMenuButtonStyle}" ToolTip.Tip="View application information" />
                    <Button Content="Exit" Click="ExitMenuItem_Click" Theme="{StaticResource ExitMenuButtonStyle}" ToolTip.Tip="Close the application" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="10" RowDefinitions="*,Auto,Auto">

            <Grid x:Name="ContentGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Operation Controls (Styled like RomValidator Borders) -->
                <Border x:Name="ControlsBorder" Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,10,0">
                    <Grid>
                    <!-- Conversion View -->
                    <Grid x:Name="ConvertView" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                        <Grid Margin="0,0,0,10" ColumnDefinitions="150,*,Auto">
                            <Label Content="Source Folder:" ToolTip.Tip="The folder containing ISO, ZIP, RAR, or 7z files to convert" />
                            <TextBox x:Name="ConversionInputFolderTextBox" Grid.Column="1" IsReadOnly="True" Margin="5,0" ToolTip.Tip="Select the folder containing ISO or archive files" />
                            <Button Grid.Column="2" Content="Browse..." Click="BrowseConversionInputButton_ClickAsync" Theme="{StaticResource ActionButtonStyle}" ToolTip.Tip="Browse for source folder" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,10" ColumnDefinitions="150,*,Auto">
                            <Label Content="Output Folder:" ToolTip.Tip="The folder where converted files will be saved" />
                            <TextBox x:Name="ConversionOutputFolderTextBox" Grid.Column="1" IsReadOnly="True" Margin="5,0" ToolTip.Tip="Select the output folder for converted files" />
                            <Button Grid.Column="2" Content="Browse..." Click="BrowseConversionOutputButton_ClickAsync" Theme="{StaticResource ActionButtonStyle}" ToolTip.Tip="Browse for output folder" />
                        </Grid>
                        <Expander Grid.Row="2" Header="Options" Margin="0,5,0,10" Padding="10,8" IsExpanded="True" ToolTip.Tip="Configure conversion behavior such as file deletion, subfolder search, and integrity checking. Click the header to collapse or expand.">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4" ToolTip.Tip="Choose the output format: optimized XISO, ZAR (ZArchive/zstd), CSO (compressed ISO), or CHD (Compressed Hunks of Data)">
                                    <Label Content="Output Format:" VerticalAlignment="Center" Padding="0,0,8,0" ToolTip.Tip="Choose the format for the converted output files" />
                                    <RadioButton x:Name="OutputFormatXisoRadio" Content="XISO" IsChecked="True" GroupName="OutputFormat" Margin="0,0,14,0" ToolTip.Tip="Optimized XISO image (.iso) — the standard trimmed Xbox image" />
                                    <RadioButton x:Name="OutputFormatZarRadio" Content="ZAR" GroupName="OutputFormat" Margin="0,0,14,0" ToolTip.Tip="ZArchive (.zar) — zstd-compressed image, loadable in Xenia canary" />
                                    <RadioButton x:Name="OutputFormatCsoRadio" Content="CSO" GroupName="OutputFormat" Margin="0,0,14,0" ToolTip.Tip="Compressed ISO (.cso) — CISO v2 (LZ4), xdvdfs-compatible" />
                                    <RadioButton Content="CHD" GroupName="OutputFormat" ToolTip.Tip="Compressed Hunks of Data (.chd) — CHD v5 with the chdman createdvd preset, readable by MAME-compatible tools" />
                                </StackPanel>
                                <CheckBox x:Name="DeleteOriginalsCheckBox" Content="Delete original files after successful conversion" Margin="0,2,0,2" HorizontalAlignment="Left" ToolTip.Tip="Deletes the original ISO/archive if conversion is successful. Use with caution!" />
                                <CheckBox x:Name="SearchSubfoldersConversionCheckBox" Content="Search for files in subfolders" Margin="0,8,0,8" HorizontalAlignment="Left" ToolTip.Tip="Include files found in subdirectories of the source folder" IsCheckedChanged="SearchSubfoldersCheckBox_Changed" />
                                <CheckBox x:Name="SkipSystemUpdateCheckBox" Content="Skip $SystemUpdate folder during conversion" Margin="0,2,0,2" HorizontalAlignment="Left" ToolTip.Tip="Omits the $SystemUpdate folder from the output, reducing file size" />
                                <CheckBox x:Name="CheckOutputIntegrityCheckBox" Content="Check integrity of the output file" Margin="0,8,0,8" HorizontalAlignment="Left" IsChecked="True" ToolTip.Tip="Performs a structural integrity check on the converted file (for ZAR/CSO the source image is validated)" />
                            </StackPanel>
                        </Expander>
                        <Label Grid.Row="3" Content="Select Files to Convert:" Margin="0,5,0,0" FontWeight="SemiBold" ToolTip.Tip="Tick the files to include in the batch conversion" />
                        <DataGrid x:Name="ConversionFilesDataGrid" Grid.Row="4" MinHeight="120" Margin="0,5" AutoGenerateColumns="False" Classes="FileList" ToolTip.Tip="Files found in the source folder. Untick any file you do not want to convert.">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected, Mode=TwoWay}" Width="95" />
                                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="110" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5" ToolTip.Tip="Select or deselect all files in the conversion list">
                            <Button Content="Select All" Click="SelectAllConversion_Click" Theme="{StaticResource ActionButtonStyle}" Padding="10,5" ToolTip.Tip="Tick every file in the list" />
                            <Button Content="Deselect All" Click="DeselectAllConversion_Click" Theme="{StaticResource ActionButtonStyle}" Padding="10,5" ToolTip.Tip="Untick every file in the list" />
                        </StackPanel>
                        <Button Grid.Row="6" Content="Start Conversion" Theme="{StaticResource StartButtonStyle}" HorizontalAlignment="Center" Margin="0,5,0,0" Click="StartConversionButton_ClickAsync" ToolTip.Tip="Begin the batch conversion process" />
                    </Grid>

                    <!-- Test View (Hidden by default) -->
                    <Grid x:Name="TestView" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <Grid Margin="0,0,0,10" ColumnDefinitions="150,*,Auto">
                            <Label Content="Image Folder:" ToolTip.Tip="The folder containing ISO, CSO, ZAR, or CHD files to test for structural integrity" />
                            <TextBox x:Name="TestInputFolderTextBox" Grid.Column="1" IsReadOnly="True" Margin="5,0" ToolTip.Tip="Select the folder containing ISO, CSO, ZAR, or CHD files to test" />
                            <Button Grid.Column="2" Content="Browse..." Click="BrowseTestInputButton_ClickAsync" Theme="{StaticResource ActionButtonStyle}" ToolTip.Tip="Browse for image folder" />
                        </Grid>
                        <Expander Grid.Row="1" Header="Options" Margin="0,5,0,5" Padding="10,8" IsExpanded="True" ToolTip.Tip="Configure integrity test behavior such as file sorting and scan depth. Click the header to collapse or expand.">
                            <StackPanel Orientation="Vertical">
                                <CheckBox x:Name="MoveSuccessFilesCheckBox" Content="Move successfully tested images to a '_success' subfolder" Margin="0,5,0,0" HorizontalAlignment="Left" IsChecked="False" ToolTip.Tip="Moves valid images to a '_success' folder within the source folder" />
                                <CheckBox x:Name="MoveFailedFilesCheckBox" Content="Move failed tested images to a '_failed' subfolder" Margin="0,5,0,0" HorizontalAlignment="Left" IsChecked="False" ToolTip.Tip="Moves invalid images to a '_failed' folder within the source folder" />
                                <CheckBox x:Name="SearchSubfoldersTestCheckBox" Content="Search for files in subfolders" Margin="0,5,0,0" HorizontalAlignment="Left" IsChecked="True" ToolTip.Tip="Include files found in subdirectories of the source folder" IsCheckedChanged="SearchSubfoldersCheckBox_Changed" />
                                <CheckBox x:Name="PerformDeepScanCheckBox" Content="Perform deep surface scan (slower)" Margin="0,5,0,5" HorizontalAlignment="Left" IsChecked="False" ToolTip.Tip="Reads the entire image (and decompresses every block for CSO/ZAR/CHD) to detect bad sectors or corrupt blocks. Unchecked performs the logical structure test only (faster)." />
                            </StackPanel>
                        </Expander>
                        <Label Grid.Row="2" Content="Select Files to Test:" Margin="0,5,0,0" FontWeight="SemiBold" ToolTip.Tip="Tick the ISO, CSO, ZAR, or CHD files to include in the integrity test" />
                        <DataGrid x:Name="TestFilesDataGrid" Grid.Row="3" MinHeight="120" Margin="0,5" AutoGenerateColumns="False" Classes="FileList" ToolTip.Tip="ISO, CSO, ZAR, and CHD files found in the folder. Untick any file you do not want to test.">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected, Mode=TwoWay}" Width="95" />
                                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="110" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5" ToolTip.Tip="Select or deselect all files in the test list">
                            <Button Content="Select All" Click="SelectAllTest_Click" Theme="{StaticResource ActionButtonStyle}" Padding="10,5" ToolTip.Tip="Tick every file in the list" />
                            <Button Content="Deselect All" Click="DeselectAllTest_Click" Theme="{StaticResource ActionButtonStyle}" Padding="10,5" ToolTip.Tip="Untick every file in the list" />
                        </StackPanel>
                        <Button Grid.Row="5" Content="Start Integrity Test" Theme="{StaticResource StartButtonStyle}" HorizontalAlignment="Center" Margin="0,5,0,0" Click="StartTestButton_ClickAsync" ToolTip.Tip="Begin the batch integrity test process" />
                    </Grid>

                    <!-- Explorer View: file picker with the explorer below it -->
                    <Grid x:Name="ExplorerHeaderView" IsVisible="False" RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="150,*,Auto">
                            <Label Content="Select Image File:" ToolTip.Tip="Choose an ISO, CSO, ZAR, or CHD file to browse its internal file system" />
                            <TextBox x:Name="ExplorerFilePathTextBox" Grid.Column="1" IsReadOnly="True" Margin="5,0" ToolTip.Tip="Select an Xbox image to explore its contents" />
                            <Button Content="Browse..." Grid.Column="2" Click="BrowseExplorerFile_ClickAsync" Theme="{StaticResource ActionButtonStyle}" ToolTip.Tip="Browse for an Xbox image" />
                        </Grid>

                        <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="2" CornerRadius="4" Background="{StaticResource TerminalBackgroundBrush}" Padding="10">
                            <Grid RowDefinitions="Auto,*">

                                <!-- Navigation Bar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                                    <Button x:Name="ExplorerUpButton" Content="⬆ Up" Click="ExplorerUpButton_Click" Width="60" Margin="0,0,10,0" IsEnabled="False" Theme="{StaticResource ActionButtonStyle}" ToolTip.Tip="Go up one directory level" />
                                    <TextBlock Text="Current Path: " VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TerminalForegroundBrush}" ToolTip.Tip="The current directory path within the image file system" />
                                    <TextBlock x:Name="ExplorerPathTextBlock" Text="/" VerticalAlignment="Center" Foreground="{StaticResource TerminalForegroundBrush}" ToolTip.Tip="Full path of the current directory inside the image" />
                                </StackPanel>

                                <!-- File List -->
                                <DataGrid x:Name="ExplorerDataGrid" Grid.Row="1" Classes="Explorer"
                                          DoubleTapped="ExplorerDataGrid_DoubleTappedAsync"
                                          PointerPressed="ExplorerDataGrid_PointerPressed"
                                          PointerMoved="ExplorerDataGrid_PointerMovedAsync"
                                          PointerReleased="ExplorerDataGrid_PointerReleased"
                                          PointerCaptureLost="ExplorerDataGrid_PointerCaptureLost"
                                          ToolTip.Tip="Double-click directories to navigate, double-click files to extract. Drag and drop files to copy them out of the image.">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Name" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:XisoExplorerItem">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IsDirectory, Converter={StaticResource FolderIconConverter}}" Margin="0,0,5,0" FontFamily="Segoe UI Emoji, Noto Color Emoji, Apple Color Emoji" Foreground="{StaticResource TerminalForegroundBrush}" ToolTip.Tip="Folder or file indicator" />
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TerminalForegroundBrush}" ToolTip.Tip="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>
                </Border>

                <!-- Splitter between the controls and the log -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ToolTip.Tip="Drag to resize the panels" />

                <!-- 1. Log Content -->
                <Border x:Name="LogBorder" Grid.Column="2" Margin="10,0,0,0" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="2" CornerRadius="4" Background="{StaticResource TerminalBackgroundBrush}">
                     <TextBox x:Name="LogViewer"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             FontFamily="{StaticResource TerminalFontFamily}"
                             FontSize="13"
                             Background="{StaticResource TerminalBackgroundBrush}"
                             Foreground="{StaticResource TerminalForegroundBrush}"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Padding="8"
                             CaretBrush="{StaticResource TerminalForegroundBrush}"
                             ToolTip.Tip="Displays real-time conversion, testing, and general operation output logs. Only the newest lines are kept so heavy logging cannot freeze the window.">
                        <TextBox.Effect>
                            <DropShadowEffect OffsetX="0" OffsetY="0" Color="#39FF14" BlurRadius="2" Opacity="0.4"/>
                        </TextBox.Effect>
                    </TextBox>
                </Border>
            </Grid>

            <!-- 2. Stats Panel -->
            <Grid x:Name="StatsPanel" Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="*,*,*,*,*,*,*">
                <Border Grid.Column="0" Theme="{StaticResource StatsCardBorderStyle}" ToolTip.Tip="Total number of files processed in the current batch operation">
                    <StackPanel>
                        <TextBlock Text="Total Files:" Theme="{StaticResource StatsLabelStyle}" ToolTip.Tip="Total number of files in the current operation"/>
                        <TextBlock x:Name="TotalFilesValue" Text="0" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Total number of files in the current operation"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Theme="{StaticResource StatsCardBorderStyle}" ToolTip.Tip="Number of files that completed successfully">
                    <StackPanel>
                        <TextBlock Text="Success:" Theme="{StaticResource StatsLabelStyle}" Foreground="{StaticResource SuccessTextBrush}" ToolTip.Tip="Number of files that completed successfully"/>
                        <TextBlock x:Name="SuccessValue" Text="0" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Number of files that completed successfully"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Theme="{StaticResource StatsCardBorderStyle}" ToolTip.Tip="Number of files that failed processing">
                    <StackPanel>
                        <TextBlock Text="Failed:" Theme="{StaticResource StatsLabelStyle}" Foreground="{StaticResource FailedTextBrush}" ToolTip.Tip="Number of files that failed processing"/>
                        <TextBlock x:Name="FailedValue" Text="0" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Number of files that failed processing"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Theme="{StaticResource StatsCardBorderStyle}" ToolTip.Tip="Number of files that were skipped (e.g., already converted or incompatible)">
                    <StackPanel>
                        <TextBlock Text="Skipped:" Theme="{StaticResource StatsLabelStyle}" Foreground="{StaticResource SkippedTextBrush}" ToolTip.Tip="Number of files that were skipped"/>
                        <TextBlock x:Name="SkippedValue" Text="0" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Number of files that were skipped"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Theme="{StaticResource StatsCardBorderStyle}" ToolTip.Tip="Total elapsed processing time for the current batch operation">
                    <StackPanel>
                        <TextBlock Text="Time:" Theme="{StaticResource StatsLabelStyle}" ToolTip.Tip="Elapsed time of the current operation"/>
                        <TextBlock x:Name="ProcessingTimeValue" Text="00:00:00" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Elapsed time of the current operation"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Theme="{StaticResource StatsCardBorderStyle}" ToolTip.Tip="Current read speed of the active operation">
                    <StackPanel>
                        <TextBlock Text="Read Speed:" Theme="{StaticResource StatsLabelStyle}" ToolTip.Tip="Current read speed of the active drive"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="ReadSpeedValue" Text="N/A" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Current read speed of the active drive"/>
                            <TextBlock x:Name="ReadSpeedDriveIndicator" Text="" Margin="5,0,0,0" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Drive currently being read"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Theme="{StaticResource StatsCardBorderStyle}" ToolTip.Tip="Current write speed of the active operation">
                    <StackPanel>
                        <TextBlock Text="Write Speed:" Theme="{StaticResource StatsLabelStyle}" ToolTip.Tip="Current write speed of the active drive"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="WriteSpeedValue" Text="N/A" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Current write speed of the active drive"/>
                            <TextBlock x:Name="WriteSpeedDriveIndicator" Text="" Margin="5,0,0,0" Theme="{StaticResource StatsValueStyle}" ToolTip.Tip="Drive currently being written to"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Progress Area -->
            <Grid x:Name="ProgressAreaGrid" Grid.Row="2" Margin="0,10,0,0" IsVisible="False" ColumnDefinitions="*,Auto">
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1" Background="{StaticResource CardBackgroundBrush}">
                    <Grid>
                        <ProgressBar x:Name="ProgressBar" Height="24" Foreground="{StaticResource ProgressForegroundBrush}" Background="{StaticResource ProgressBackgroundBrush}" BorderThickness="0" ToolTip.Tip="Progress of the current batch operation" />
                        <TextBlock x:Name="ProgressTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip.Tip="Current operation progress percentage and file name" />
                    </Grid>
                </Border>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Theme="{StaticResource CancelButtonStyle}" Margin="10,0,0,0" IsVisible="False" Click="CancelButton_Click" ToolTip.Tip="Cancel the current operation" />
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource StatusBarBackgroundBrush}" Padding="5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusTextBlock" Text="Ready." ToolTip.Tip="Displays current application status and messages" />
                <TextBlock Grid.Column="1" x:Name="MemoryTextBlock" Text="Memory: 0 MB" FontSize="11" ToolTip.Tip="Current application memory usage" />
            </Grid>
        </Border>
    </Grid>
</Window>
