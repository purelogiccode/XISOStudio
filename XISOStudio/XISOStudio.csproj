<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>icon\icon.ico</ApplicationIcon>
        <Authors>PureLogicCode</Authors>
        <Company>PureLogicCode.com</Company>
        <IsPackable>false</IsPackable>
        <Version>3.0.2</Version>
        <AssemblyVersion>3.0.2</AssemblyVersion>
        <FileVersion>3.0.2</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="icon\icon.ico" />
        <!-- Bundled 7-Zip CLI fallback, per platform/architecture. These are Content items
             (None items are not part of the publish pipeline) and are excluded from the
             single-file bundle so they stay as separate files next to the executable, where
             the extractor expects to find them. On Windows the app also auto-detects a
             system installation; on Linux/macOS it falls back to 7z on the PATH. -->
        <None Remove="7za.exe" />
        <None Remove="7za_arm64.exe" />
        <None Remove="7zz_linux_x64" />
        <None Remove="7zz_linux_arm64" />
        <None Remove="7zz_osx" />
        <None Remove="7-Zip-License.txt" />
        <Content Include="7za.exe" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
        <Content Include="7za_arm64.exe" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
        <Content Include="7zz_linux_x64" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
        <Content Include="7zz_linux_arm64" Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
        <Content Include="7zz_osx" Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
        <!-- 7-Zip is LGPL-licensed; its license must accompany the bundled binaries. -->
        <Content Include="7-Zip-License.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.294">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="CHDSharp" Version="1.4.3" />
        <PackageReference Include="SharpCompress" Version="0.50.4" />
        <PackageReference Include="XISOSharp" Version="1.4.2" />
        <PackageReference Include="ZArchiveSharp" Version="1.4.0" />
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="References\**" />
        <AvaloniaResource Remove="References\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="References\**" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="images\about.png" />
        <AvaloniaResource Include="images\exit.png" />
        <AvaloniaResource Include="images\logo.png" />
        <AvaloniaResource Include="icon\icon.ico" />
        <AvaloniaResource Include="icon\icon.png" />
    </ItemGroup>

</Project>